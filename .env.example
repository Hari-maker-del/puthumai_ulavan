# ─────────────────────────────────────────────────────────────
# Puthumai Uzhavan v2.0 — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────

# Supabase (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Gemini AI (required for AI Assistant features)
# Get a free key at https://aistudio.google.com
VITE_GEMINI_API_KEY=
# Stable production model. Do not use the retired Gemini 2.0 Flash IDs.
VITE_GEMINI_MODEL=gemini-3.6-flash

# OpenWeather API
# LOCAL ONLY: used by `npm run dev` when Vercel Functions are not running.
# NEVER use a VITE_ weather key in production.
VITE_OPENWEATHER_API_KEY=

# VERCEL PRODUCTION: server-side OpenWeather key (never exposed to the browser).
# If omitted or temporarily invalid, the Vercel weather function uses Open-Meteo
# as a real-data provider instead of fake/mock data.
OPENWEATHER_API_KEY=

# Set to "true" ONLY for local demo/mock mode. Production defaults to real services.
VITE_USE_MOCK=false
