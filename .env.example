# ─────────────────────────────────────────────────────────────
# Puthumai Uzhavan v2.0 — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────

# Supabase (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Gemini AI — SERVER ONLY (Vercel environment variables)
# NEVER use the VITE_ prefix for the Gemini secret.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server-side Supabase auth (Vercel environment variables)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Weather uses Open-Meteo; no browser API key is required for non-commercial use.

# Government of India daily mandi prices (data.gov.in / AGMARKNET)
VITE_DATA_GOV_API_KEY=

# Set to "true" ONLY for local demo/mock mode. Production defaults to real services.
VITE_USE_MOCK=false
